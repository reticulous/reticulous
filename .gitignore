# OS / editor
.DS_Store
._*

# Auto-generated artifacts (added by maintenance sweep)
__pycache__/
*.pyc
*.pyo

# Build artifacts (spangap-generated)
esp-idf/build/
esp-idf/sdkconfig
esp-idf/sdkconfig.old
esp-idf/staging/
esp-idf/managed_components/
web-interface/node_modules/
web-interface/dist/
web-interface/.quasar/
# Quasar compiles its config to a throwaway beside it, stamped with the epoch
# millisecond of the run, and does not always clear up after itself.
web-interface/*.temporary.compiled.*.mjs

# Generated each build (browser straddle dispatcher)
web-interface/src/boot/*.gen.ts

# Generated each build: the spangap build wipes this dir and copies in every
# staged straddle's assets/lcd-icons/*.svg (this repo's own source of truth is
# assets/lcd-icons/). Which icons appear depends on the staged set, so
# tracking them just churns.
web-interface/src/app-icons/

# Generated each build (staged SPA bundle + build stamp baked into the data partition)
data/webroot/
data/build_times

# A build tree for a target that is not the one in build/ — parked beside it so
# switching between a chip build and the host build costs no rebuild.
esp-idf/build.*/

# What a run of the simulated testbed leaves behind: one directory per station
# (its state store, its console log) and the ether's account of the air.
sim/nodes/
sim/record.tsv
